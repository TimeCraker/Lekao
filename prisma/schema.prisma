// ============================================
// Lekao - Prisma schema (PRD §3.4)
// ============================================
// ⚠️ 共享 users 表归 ResumeAIX 管，Lekao 只读引用
// ⚠️ 绝不能 prisma db push --force (会误删 ResumeAIX 用户数据)
// ⚠️ 部署只用 prisma migrate deploy (带历史 migration 文件)
//
// DB: PostgreSQL :5434/resumeaix (与 ResumeAIX 共享实例)
// .env DATABASE_URL 必须带 ?connection_limit=4&pool_timeout=20

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ⚠️ 只读引用 (ResumeAIX 管, Lekao 永远不 migrate)
// ============================================

// PG 共享 enum (ResumeAIX 定义, Lekao 引用一致以避免转换错)
enum UserRole {
  USER
  ADMIN

  @@map("UserRole")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String? // bcrypt hash
  name            String?
  role            UserRole @default(USER) @map("role") // PG enum "UserRole" (USER/ADMIN)
  t_coin          Int      @default(0) @map("tCoin") // 充值 T-Coin (ResumeAIX/Lekao 共享) · PG 列名 tCoin
  lekao_gift_coin Int      @default(-1) @map("lekaoGiftCoin") // ⭐ Lekao 赠送 (默认 -1, signIn 延迟初始化为 5) · PG 列名 lekaoGiftCoin
  banned          Boolean  @default(false) @map("banned") // ⭐ P0#3 admin 封禁 (true = 封禁, 默认 false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 反向关系 (Lekao 业务表挂在 userId 上)
  classSummaries   LekaoClassSummary[]
  classFeedbacks   LekaoClassFeedback[]
  coinLogs         LekaoCoinLog[]          @relation("CoinLogUser")
  coinLogsByAdmin  LekaoCoinLog[]          @relation("CoinLogAdmin")
  auditLogsTarget  AuditLog[]              @relation("AuditLogTarget")
  auditLogsByAdmin AuditLog[]              @relation("AuditLogAdmin")

  @@map("users")
}

// ============================================
// Lekao 业务表 (Lekao 自己的 migration)
// ============================================

// 课堂小结历史 (付费数据, 必须落盘防客诉)
model LekaoClassSummary {
  id           String   @id @default(cuid())
  userId       String
  subject      String // 学科: 数学 / 物理 / 化学
  topic        String // 精准提炼的专题名称
  templateId   String? // 使用的模板 ID
  inputImages  String[] // 输入图片 URL (COS)
  feedbackText String   @db.Text // 10 条建议
  summaryText  String   @db.Text // 总体小结
  tCoinUsed    Int      @default(1)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("lekao_class_summaries")
}

// 课堂反馈历史 (付费数据, 必须落盘防客诉)
model LekaoClassFeedback {
  id           String   @id @default(cuid())
  userId       String
  subject      String
  topic        String
  templateId   String?
  inputImages  String[]
  description  String?  @db.Text // 助教简单描述
  feedbackText String   @db.Text // AI 生成的反馈
  tCoinUsed    Int      @default(1)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("lekao_class_feedbacks")
}

// 模板 (平台预设 + 用户自定义)
model LekaoTemplate {
  id        String   @id @default(cuid())
  userId    String? // null 表示平台预设
  name      String
  type      String // summary | feedback
  subject   String? // 适用学科 (null 表示通用)
  content   String   @db.Text
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@map("lekao_templates")
}

// 验证码记录 (防刷)
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String? // ⭐ 已废弃: 新数据只存 codeHash, 老数据可读兼容
  codeHash  String? // bcrypt(code, cost=10) 哈希值 (DB 泄露也不暴露明文)
  attempts  Int      @default(0) // 失败计数, 5 次后锁定 1 小时
  purpose   String // register | login | reset
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose, expiresAt])
  @@map("verification_codes")
}

// 邀请码
model InvitationCode {
  id             String    @id @default(cuid())
  code           String    @unique // 邀请码 (大写字母 + 数字)
  used           Boolean   @default(false)
  usedByUserId   String?   // 使用者的 userId
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("invitation_codes")
}

// ============================================
// P0 三件套 (2026-06-22) — admin 后台关键缺口补齐
// ============================================

// T-Coin 调币流水 (P0#1) — 客诉可查, 调币审计
model LekaoCoinLog {
  id          String   @id @default(cuid())
  userId      String   // 被调币用户
  adminId     String   // 操作 admin
  amount      Int      // 正数=增加, 负数=扣除
  beforeGift  Int      // 调前赠送币
  beforePaid  Int      // 调前充值币
  afterGift   Int      // 调后赠送币
  afterPaid   Int      // 调后充值币
  reason      String?  // 调币原因
  createdAt   DateTime @default(now())

  user        User     @relation("CoinLogUser", fields: [userId], references: [id])
  admin       User     @relation("CoinLogAdmin", fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@map("lekao_coin_log")
}

// admin 操作审计日志 (P0#2) — 谁在什么时候干了什么
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   // 操作的 admin
  targetUserId String? // 操作对象 (用户) — 可空 (如邀请码生成无 target)
  action     String   // tcoin_adjust | user_update | user_ban | user_unban | invite_create | ...
  details    String?  @db.Text // JSON 详情 (改了什么字段 / 改前改后值)
  ip         String?  // 操作 IP (from req.headers)
  createdAt  DateTime @default(now())

  admin      User     @relation("AuditLogAdmin", fields: [adminId], references: [id])
  targetUser User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
