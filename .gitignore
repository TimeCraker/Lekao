# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (E2E 运行产物不入仓)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit .env.example as template, ignore all others)
.env
.env.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lighthouse (CI 跑分产物, 不入仓)
lighthouse-mobile.json
lighthouse-mobile-*.json
lighthouse-mobile.html
lighthouse-mobile-*.html
lighthouse-*.json
lighthouse-*.html
lighthouse-a11y-*.json

# Local AI-agent temporary state; canonical project instructions live in Git.
/.pi/
/.agents-tmp/

# 教学原文 / 学生 PII —— 真实讲义、反馈表、错题集，绝不进 git（本地保留）
/references/
# docs/ 下办公文档一律不入库（易含学生 PII，新增同类文件自动忽略）
/docs/*.doc
/docs/*.docx
/docs/*.xls
/docs/*.xlsx
/docs/*.pdf
/docs/*.csv

# Android APK 二进制走 GitHub Releases，不进 git（hero 下载按钮指向 release URL）
*.apk
public/downloads/*.apk

e2e/.auth/
e2e/visual-baselines/
e2e/fullflow/

# 真实测试文档数据（含学生姓名，不入仓；仅 README 入仓）
/e2e/test-docs/*
!/e2e/test-docs/README.md
