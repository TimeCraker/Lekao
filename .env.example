# ============================================
# Lekao - 环境变量模板（commit 到 git，供协作者参考）
# ============================================
# ⚠️ 真实密钥写到 .env（已 gitignore），不要 commit

# ============================================
# AI Provider · 视觉（硅基流动 Qwen3-VL-8B-Instruct）
# ============================================
# 注册：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ============================================
# AI Provider · 文本（DeepSeek 官方 V4 Flash）
# ============================================
# 注册：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ============================================
# 数据库 (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/lekao?schema=public&connection_limit=4&pool_timeout=20"

# ============================================
# NextAuth
# ============================================
NEXTAUTH_SECRET=generate-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ============================================
# SMTP（验证码邮件）
# ============================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email@qq.com

# ============================================
# Redis（在线状态与会话缓存）
# ============================================
REDIS_URL=redis://localhost:6379
