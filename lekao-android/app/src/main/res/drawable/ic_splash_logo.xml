<?xml version="1.0" encoding="utf-8"?>
<!--
  Lekao Splash Logo · 启动屏 + LoginScreen 顶部 72dp logo
  与 launcher icon / Web 端 src/app/icon.tsx 品牌 100% 一致:
  - 黑色圆底 + L 字 (cream) + signal coral 右上角圆点
  - 108×108 viewport 全可见 (不是 adaptive icon, 不需要安全区)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 黑色圆形底 (中心 54, 半径 48) -->
    <path
        android:fillColor="#1a1a1a"
        android:pathData="M 54,6 A 48,48 0 1,0 54.001,6 Z" />

    <!-- L 字 (粗笔画, 圆内水平居中略偏左) -->
    <path
        android:fillColor="#faf8f3"
        android:pathData="M 30,30 L 42,30 L 42,60 L 72,60 L 72,72 L 30,72 Z" />

    <!-- signal coral 圆点 (右上角) -->
    <path
        android:fillColor="#e85a3c"
        android:pathData="M 68,22 A 6,6 0 1,0 68.001,22 Z" />

</vector>