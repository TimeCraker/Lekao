    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "nodemailer@<10.0.6": "^10.0.13",
      "uuid@<11.1.1": "^11.1.1",
      "brace-expansion@<2.0.0": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
