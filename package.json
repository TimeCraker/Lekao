    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "prepare": "husky",
    "perf:audit": "node scripts/perf-audit.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "docx": "^9.0.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "motion": "^12.40.0",
    "next": "16.3.7",
    "next-auth": "4",
    "nodemailer": "^10.0.13",
    "openai": "^6.44.0",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,tsx}": [
      "prettier --write",
      "eslint --fix"
